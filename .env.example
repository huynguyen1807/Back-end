PORT=4000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=freshfriends
JWT_SECRET=<long-random-secret>
JWT_EXPIRES_IN=7d

GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=<primary-gemini-model>
GEMINI_MODELS=<comma-separated-fallback-models>
GEMINI_SCAN_MAX_MODEL_ATTEMPTS=1

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<brevo-smtp-login>
SMTP_PASS=<brevo-smtp-key>
SMTP_FROM_NAME=FreshFriends
SMTP_FROM_EMAIL=<verified-brevo-sender-email>

CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

OPENROUTESERVICE_API_KEY=<openrouteservice-api-key>

REVENUECAT_WEBHOOK_AUTH=<revenuecat-webhook-secret>
REVENUECAT_ENTITLEMENT_ID=premium
REVENUECAT_MONTHLY_PRODUCT_ID=monthly
REVENUECAT_YEARLY_PRODUCT_ID=yearly
